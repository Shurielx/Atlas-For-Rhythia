{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atlas for Rhythia",
  "version": "0.13.10",
  "identifier": "com.shuriel.atlas",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Atlas for Rhythia",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data: http://cover.localhost cover:; media-src http://song.localhost song:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'",
      "freezePrototype": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "nsis": { "installerHooks": "windows/hooks.nsh" }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI0Nzc2MzEwQzREREY3MDAKUldRQTk5M0VFR04zdElvM0FVeUEzNk9pMmJLVXR3dzFTeEFJWXYyNVJmenJNTFhOZFlaei8zcmkK",
      "endpoints": ["https://github.com/Shurielx/Atlas-For-Rhythia/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    },
    "deep-link": {
      "desktop": {
        "schemes": ["atlas"]
      }
    }
  }
}
